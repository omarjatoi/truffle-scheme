load("//bazel:java.bzl", "scheme_java_library")

# The runtime project. The Bytecode DSL root, operations, continuations and the language class,
# and the language's native-image configuration (META-INF/native-image). Its packages refer to each
# other (scheme.runtime, its values, its printer, and the records' superclass, alone in
# scheme.runtime.staticobject: design.md D11, "Modules"), so they are one library.
scheme_java_library(
    name = "runtime",
    srcs = glob([
        "scheme/runtime/*.java",
        "scheme/runtime/printer/*.java",
        "scheme/runtime/staticobject/*.java",
        "scheme/runtime/value/*.java",
    ]),
    bytecode_root = True,
    resource_strip_prefix = "src/runtime",
    resources = glob(["META-INF/**"]),
    truffle_dsl = True,
    visibility = ["//visibility:public"],
    deps = [
        "@jvm//:org_graalvm_polyglot_polyglot",
        "@jvm//:org_graalvm_sdk_nativeimage",
        "@jvm//:org_graalvm_sdk_word",
        "@jvm//:org_graalvm_truffle_truffle_api",
    ],
)

# For //tests:nix, which compares nix/packages.json with it (design.md D11, "Nix packages").
exports_files(
    ["BUILD.bazel"],
    visibility = ["//tests:__pkg__"],
)
