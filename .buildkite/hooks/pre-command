#!/bin/bash
# Before every step: the CI dev shell's environment (flake.nix .#ci: just Bazel), and Bazel's CI
# settings in this agent's ~/.bazelrc, with the BuildBuddy key from the cluster secret. Steps then
# run plain `bazel`.
#
# The jobs run in CI's agent image (.buildkite/image.nix, the queue's image), which has Determinate
# Nix and every store path the shell needs, so here Nix only evaluates the flake: nothing is
# installed or downloaded. Any other image is a misconfigured queue, and the hook stops. When
# flake.lock or the shell changed since the image was built, Nix downloads what changed and the
# build gets an annotation saying so, until the pipeline's `image` step on main pushes a new one.
set -eo pipefail
if ! command -v nix >/dev/null; then
  echo "^^^ +++"
  echo "There's no nix on PATH: this queue must run the CI image, see docs/design.md D11" \
    "(.buildkite/image.nix, pushed by .buildkite/push-image.sh)." >&2
  exit 1
fi

# The shell's PATH and the like; the agent's own SHELL and temporary directory stay.
shell="$SHELL" tmpdir="${TMPDIR:-/tmp}"
env_profile="$(mktemp -d)/ci"
# Assigned first, so that the hook fails if Nix does (`eval "$(...)"` would carry on without it).
env_script="$(nix print-dev-env --profile "$env_profile" .#ci)"
eval "$env_script"
unset env_script
export SHELL="$shell" TMPDIR="$tmpdir"
unset TMP TEMP TEMPDIR NIX_BUILD_TOP SOURCE_DATE_EPOCH

if [ -e /etc/ci-image/shell-env ] &&
  [ "$(readlink -f "$env_profile")" != "$(readlink -f /etc/ci-image/shell-env)" ]; then
  buildkite-agent annotate --style warning --context ci-image \
    "CI's agent image is stale: the \`.#ci\` shell changed since it was built, so each job downloads it. On \`main\`, the pipeline's \`image\` step pushes a new one; if it didn't run, push it with \`.buildkite/push-image.sh\` (docs/design.md D11)."
fi
unset env_profile

# Only this agent's user reads it; nothing uploads it.
umask 077
cat > "$HOME/.bazelrc" <<EOF
common --config=ci
common:buildbuddy --remote_header=x-buildbuddy-api-key=$BUILDBUDDY_API_KEY
common --build_metadata=ROLE=CI
common --build_metadata=REPO_URL=$BUILDKITE_REPO
common --build_metadata=COMMIT_SHA=$BUILDKITE_COMMIT
common --build_metadata=BRANCH_NAME=$BUILDKITE_BRANCH
EOF

buildkite-agent annotate --context buildbuddy \
  "BuildBuddy: [this commit's invocations](https://app.buildbuddy.io/history/commit/$BUILDKITE_COMMIT)"
