load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# The differential fuzzer (README.md): the generator and the driver `bazel run //:r7rs -- fuzz` runs.
py_library(
    name = "fuzz",
    srcs = [
        "fuzz.py",
        "gen.py",
    ],
    imports = ["."],
    deps = ["//tests/harness"],
)

# A fixed seed's programs, interpreted: the generator and the driver still work, and nothing they
# found is back. Deterministic, so cached like any test. Through tests/harness/run_test.py, which
# writes its result as JUnit XML.
py_test(
    name = "fuzz_smoke",
    size = "large",
    srcs = [
        "smoke.py",
        "//tests/harness:run_test.py",
    ],
    args = [
        "smoke",
        "--runtime=$(rlocationpath //:launcher_runtime)",
        "--chibi=$(rlocationpath //bazel:chibi-scheme)",
        "--seed=1",
        "--count=300",
    ],
    data = [
        "//:launcher_runtime",
        "//bazel:chibi-scheme",
    ],
    main = "//tests/harness:run_test.py",
    tags = ["cpu:4"],
    deps = [":fuzz"],
)

# The same seed's programs through the native launcher (//:scheme-native), as `fuzz --mode native`
# runs them: interpreted, with //tests:conformance_native's options. Only when named, like the
# other native tests (tests/BUILD.bazel): the launcher takes a minute and a few GB to build.
py_test(
    name = "fuzz_smoke_native",
    size = "large",
    srcs = [
        "smoke.py",
        "//tests/harness:run_test.py",
    ],
    args = [
        "smoke",
        "--native=$(rlocationpath //:scheme-native)",
        "--chibi=$(rlocationpath //bazel:chibi-scheme)",
        "--mode=native",
        "--seed=1",
        "--count=300",
    ],
    data = [
        "//:scheme-native",
        "//bazel:chibi-scheme",
    ],
    main = "//tests/harness:run_test.py",
    tags = [
        "cpu:4",
        "manual",
    ],
    deps = [":fuzz"],
)

# The campaigns (README.md "Campaigns"): a test per mode and seed, 10,000 programs a seed in
# shards of 500 (250 under the detailed assertions, whose files may take ten minutes each), each
# shard on an executor of its own; the last seed's programs are deeper and write more cases. Only
# when named: `bazel test //tests/fuzz:fuzz_campaign` runs them all,
# `//tests/fuzz:fuzz_campaign_<mode>` a mode's. Mismatches are minimised (but not timeouts), in the
# shard's log and its outputs.
FUZZ_CAMPAIGN_SEEDS = {
    1001: [],
    1002: [],
    1003: [],
    1004: [],
    1005: [],
    1006: [
        "--depth=7",
        "--cases=12",
    ],
}

# Each mode's shards a seed, and its options.
FUZZ_CAMPAIGN_MODES = {
    "interp": (20, []),
    "compile": (40, ["--timeout=600"]),
    "torture": (40, ["--timeout=600"]),
    "torture-owned": (40, ["--timeout=600"]),
    "native": (20, []),
}

[py_test(
    name = "fuzz_campaign_%s_%d" % (mode.replace("-", "_"), seed),
    size = "enormous",
    srcs = [
        "smoke.py",
        "//tests/harness:run_test.py",
    ],
    args = [
        "smoke",
        "--chibi=$(rlocationpath //bazel:chibi-scheme)",
        "--mode=" + mode,
        "--seed=%d" % seed,
        "--count=10000",
        "--batch=10",
        "--minimize",
    ] + options + FUZZ_CAMPAIGN_MODES[mode][1] + (
        ["--native=$(rlocationpath //:scheme-native)"] if mode == "native" else ["--runtime=$(rlocationpath //:launcher_runtime)"]
    ),
    data = [
        "//:scheme-native" if mode == "native" else "//:launcher_runtime",
        "//bazel:chibi-scheme",
    ],
    main = "//tests/harness:run_test.py",
    shard_count = FUZZ_CAMPAIGN_MODES[mode][0],
    tags = [
        "cpu:4",
        "manual",
    ],
    deps = [":fuzz"],
) for mode in FUZZ_CAMPAIGN_MODES for seed, options in FUZZ_CAMPAIGN_SEEDS.items()]

[test_suite(
    name = "fuzz_campaign_" + mode.replace("-", "_"),
    tags = ["manual"],
    tests = ["fuzz_campaign_%s_%d" % (mode.replace("-", "_"), seed) for seed in FUZZ_CAMPAIGN_SEEDS],
) for mode in FUZZ_CAMPAIGN_MODES]

test_suite(
    name = "fuzz_campaign",
    tags = ["manual"],
    tests = ["fuzz_campaign_" + mode.replace("-", "_") for mode in FUZZ_CAMPAIGN_MODES],
)
