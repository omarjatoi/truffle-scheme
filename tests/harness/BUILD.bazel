load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_bench_gc.py",
    "check_compile_bound_native.py",
    "check_launcher.py",
    "check_launcher_vm.py",
    "check_launcher_vm_native.py",
    "check_polyglot_native.py",
    "check_readme.py",
    "check_rules.py",
    "check_space_native.py",
    "check_status.py",
    "check_tools.py",
    "check_versions.py",
    "run_test.py",
    "scheme.py",
])

# What the tests share (tests/harness/defs.bzl harness_test): each check_*.py depends only on the
# libraries it imports, so editing one reruns only its tests.
py_library(
    name = "harness",
    srcs = ["harness.py"],
    imports = ["."],
)

py_library(
    name = "readme",
    srcs = ["readme.py"],
    deps = [":harness"],
)

py_library(
    name = "tools",
    srcs = ["tools.py"],
    deps = [":harness"],
)

# `bazel run //:r7rs`'s commands: benchmarks, vendoring, reports.
py_library(
    name = "commands",
    srcs = [
        "bench.py",
        "check_tools.py",
        "vendor.py",
    ],
    deps = [
        ":harness",
        ":tools",
    ],
)

# `bazel run //:r7rs -- <command>` (main.py).
py_binary(
    name = "r7rs",
    srcs = ["main.py"],
    args = [
        "--runtime=$(rlocationpath //:launcher_runtime)",
        "--tools-runtime=$(rlocationpath //:scheme_runtime)",
        "--chibi=$(rlocationpath //bazel:chibi-scheme)",
        "--formatter=$(rlocationpath //bazel/lint:eclipse_format)",
        "--prefs=$(rlocationpath //bazel/lint:org.eclipse.jdt.core.prefs)",
    ],
    data = [
        "//:launcher_runtime",
        "//:scheme_runtime",
        "//bazel/lint:eclipse_format",
        "//bazel/lint:org.eclipse.jdt.core.prefs",
        "//bazel:chibi-scheme",
    ],
    main = "main.py",
    deps = [
        ":commands",
        "//tests/fuzz",
    ],
)
