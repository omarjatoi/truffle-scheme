load("@rules_java//java:defs.bzl", "java_library")
load("//bazel:java.bzl", "SCHEME_JAVACOPTS", "scheme_java_library")
load("//bazel:java_module.bzl", "java_module_jar")
load("//bazel:junit.bzl", "unit_tests")
load("//tests/harness:defs.bzl", "conformance_tests", "diff_tests", "harness_test", "space_test", "spec_tests", "tools_tests")

# Everything under tests/ but the harness is described here: tests/r7rs/ and tests/r7rs-larceny/ are
# read-only vendored suites (AGENTS.md "Never"), so they get no BUILD files of their own.

package(default_visibility = ["//visibility:public"])

# --- JUnit (tests/scheme/test) -----------------------------------------------------------------

# All of it, compiled together for the lint tests (format, Checkstyle, ECJ) only.
scheme_java_library(
    name = "scheme_test_lib",
    srcs = glob([
        "scheme/test/*.java",
        "scheme/test/upstream/*.java",
    ]),
    spotbugs = False,
    truffle_dsl = True,
    deps = [
        "//src/compiler",
        "//src/launcher",
        "//src/reader",
        "//src/runtime",
        "@jvm//:junit_junit",
        "@jvm//:org_graalvm_polyglot_polyglot",
        "@jvm//:org_graalvm_truffle_truffle_api",
    ],
)

# What the test classes share (instruments, recorders): in each "full" test class's module.
java_library(
    name = "test_support",
    srcs = [
        "scheme/test/AllocationRecorder.java",
        "scheme/test/EventRecorder.java",
        "scheme/test/ResultProbe.java",
    ],
    javacopts = SCHEME_JAVACOPTS,
    deps = [
        "//bazel:truffle_dsl_processor",
        "//src/runtime",
        "@jvm//:org_graalvm_polyglot_polyglot",
        "@jvm//:org_graalvm_truffle_truffle_api",
    ],
)

# The runtime and the reader only, as the module `scheme`: the "core" tests' language, so an edit to
# the compiler, the builtins or the prelude doesn't rerun them.
java_module_jar(
    name = "core_module",
    exports = [
        "scheme.reader",
        "scheme.runtime",
        "scheme.runtime.printer",
        "scheme.runtime.value",
    ],
    jar_name = "scheme-core",
    libs = [
        "//src/reader",
        "//src/runtime",
    ],
    module_name = "scheme",
    requires = [
        "org.graalvm.collections",
        "org.graalvm.nativeimage",
        "org.graalvm.polyglot",
        "org.graalvm.truffle",
        "org.graalvm.word",
    ],
    uses = [
        "scheme.runtime.BuiltinLibrary",
        "scheme.runtime.SchemeCompiler",
    ],
    deps = ["//bazel:truffle_modules"],
)

# `unit_<mode>_<Class>` for every *Test.java, in the modes jit (the Graal JIT in the background),
# compile (compile immediately, failures are errors) and torture; `unit_<mode>` and `unit` group
# them. Each class is its own library and module, so an edit to it reruns only its tests.
unit_tests(
    name = "unit",
    kinds = {
        "PrinterTest": "core",
        "ReaderTest": "core",
        "SuiteReadSyntaxTest": "core",
        "UpstreamAsyncStacksTest": "upstream",
        "UpstreamNestedRootSourceTest": "upstream",
        "UpstreamReportPolymorphismTest": "upstream",
        "ValuesTest": "core",
    },
    # The vendored suite's files that these read as resources.
    resources = {
        "SuiteReadSyntaxTest": glob(["r7rs/**"]),
        "SyntaxRulesTest": glob(["r7rs/**"]),
    },
    # SyntaxRulesTest reads chibi's section 4.3 with SuiteReadSyntaxTest's helper.
    extra_srcs = {"SyntaxRulesTest": ["scheme/test/SuiteReadSyntaxTest.java"]},
    support = "test_support",
    tests = glob([
        "scheme/test/*Test.java",
        "scheme/test/upstream/*Test.java",
    ]),
)

# The test drivers (diff, spec and space programs, conformance sections), in Java: they run in
# the pinned JDK and start the language in a child JVM (bazel/jvm_test.bzl java_driver_test).
scheme_java_library(
    name = "driver",
    srcs = glob(["driver/scheme/driver/*.java"]),
    spotbugs = False,
)

# tests/diff: `diff_<program>` and `diff_torture_<program>`, against chibi-scheme.
diff_tests(
    name = "diff",
    srcs = glob(["diff/*.scm"]),
    chibi = "//bazel:chibi-scheme",
    module = "//:launcher_module",
)

# tests/spec cases that need something a later task brings: {case: task}. Remove an entry when its
# task lands (tests/spec/README.md); never add back a case that has passed.
SPEC_PENDING = {}

# tests/spec: `spec_<case>`, each with the JVM limits in its header.
spec_tests(
    name = "spec",
    module = "//:launcher_module",
    srcs = [f for f in glob(["spec/*.scm"]) if f.removeprefix("spec/").removesuffix(".scm") not in SPEC_PENDING],
)

# M1-06: a 10M-iteration tail loop under a stack and heap too small for anything that grows.
space_test(
    name = "space_loop_10m",
    src = "diff/loop-10m.scm",
    expect = "10000000",
    limits = "-Xss256k -Xmx64m",
    module = "//:launcher_module",
)

# M2-05: 1M-deep non-tail recursion under a 256k Java stack (chibi runs out of stack on it).
space_test(
    name = "space_deep_recursion_1m",
    src = "space/deep-recursion-1m.scm",
    expect = "1000000",
    limits = "-Xss256k -Xmx512m",
    module = "//:launcher_module",
)

test_suite(
    name = "space",
    tests = [
        ":space_deep_recursion_1m",
        ":space_loop_10m",
    ],
)

# --- Conformance -------------------------------------------------------------------------------

filegroup(
    name = "chibi_suite",
    srcs = glob(["r7rs/**"]) + glob(["lib/**"]),
)

filegroup(
    name = "larceny_suite",
    srcs = glob(["r7rs-larceny/**"]) + glob(["lib/**"]),
)

# The suites' sections, as their sections.tsv lists them (the vendored suites don't change).
CHIBI_SECTIONS = ["4.1", "4.2", "4.3", "5", "6.1", "6.2", "6.3", "6.4", "6.5", "6.6", "6.7", "6.8", "6.9", "6.10", "6.11", "6.12", "6.13", "6.14"]

LARCENY_SECTIONS = [
    "base",
    "case-lambda",
    "char",
    "complex",
    "cxr",
    "eval",
    "file",
    "inexact",
    "lazy",
    "load",
    "read",
    "repl",
    "time",
    "write",
    "process-context",
    "process-context-getenv",
    "process-context-emergency-exit",
    "process-context-emergency-exit-37",
    "process-context-exit",
    "process-context-exit-46",
]

# `conformance_<suite>_<section>`, `conformance_compile_<suite>_<section>` and
# `conformance_torture_<suite>_<section>`: each section passes, interpreted, compiled and under
# torture, but for the listed exceptions. `conformance_status`: docs/plan.md's status block is
# what they check.
conformance_tests(
    name = "conformance",
    module = "//:launcher_module",
    plan = "//:docs/plan.md",
    suites = {
        "chibi": (":chibi_suite", "r7rs", CHIBI_SECTIONS),
        "larceny": (":larceny_suite", "r7rs-larceny", LARCENY_SECTIONS),
    },
)

# The native launcher (//:scheme-native, design.md D17), only when named: it takes a minute and a
# few GB to build. `conformance_native`: both suites through it pass what the status block says.
harness_test(
    name = "conformance_native",
    args = [
        "conformance-native",
        "$(rlocationpath //:scheme-native)",
    ],
    data = [
        ":chibi_suite",
        ":larceny_suite",
        "//:scheme-native",
    ],
    size = "large",
    tags = [
        "cpu:4",
        "manual",
    ],
)

# --- The docs' commands (docs/usage.md, docs/embedding.md: tests/harness/readme.py) -----------

_README_ARGS = [
    "--runtime=$(rlocationpath //:launcher_runtime)",
    "--usage=$(rlocationpath //:docs/usage.md)",
    "--scheme=$(rlocationpath //:scheme)",
    "--jars $(rlocationpaths //:scheme_jars)",
]

_README_DATA = [
    "scheme/test/EmbeddingGuideTest.java",
    "//:docs",
    "//:docs/usage.md",
    "//:launcher_runtime",
    "//:scheme",
    "//:scheme_jars",
]

# Every block but the native ones: commands run as written, outputs and files as shown.
harness_test(
    name = "readme",
    args = ["readme"] + _README_ARGS,
    data = _README_DATA,
    size = "large",
    tags = [
        "cpu:2",
        "requires-network",  # the debugger blocks listen on localhost
    ],
)

# The native-image blocks, against //:scheme-native.
harness_test(
    name = "readme_native",
    args = ["readme"] + _README_ARGS + ["--native=$(rlocationpath //:scheme-native)"],
    data = _README_DATA + ["//:scheme-native"],
    tags = ["manual"],
)

# --- GraalVM's tools (tests/tools) -------------------------------------------------------------

# `tools_<test>`: --help lists the tools only with them; DAP and the Chrome inspector stop at a
# breakpoint, show the stack and locals, step and continue; the CPU sampler and memory tracer run.
tools_tests(
    name = "tools",
    programs = glob(["tools/*.scm"]),
    runtime = "//:launcher_runtime",
    tools_runtime = "//:scheme_runtime",
)

# --- Checks ------------------------------------------------------------------------------------

# AGENTS.md rule 1: Java builtins never call Scheme.
harness_test(
    name = "rules",
    args = ["rules", "$(rlocationpaths //src/builtins:srcs)"],
    data = ["//src/builtins:srcs"],
    size = "small",
    tags = ["lint"],
)

# design.md D11: the test JDK is the GraalVM release of the Truffle libraries.
harness_test(
    name = "versions",
    args = [
        "versions",
        "--runtime=$(rlocationpath //:launcher_runtime)",
        "--lock=$(rlocationpath //:maven_install.json)",
    ],
    data = [
        "//:launcher_runtime",
        "//:maven_install.json",
    ],
    size = "small",
    tags = ["lint"],
)
