(import (scheme base) (scheme case-lambda) (scheme lazy) (scheme write))

;; M3-05: R7RS §4.2's derived expression types and quasiquote.
(define (show x) (write x) (newline))

(show (let ((x 2) (y 3)) (let* ((x 7) (z (+ x y))) (* z x))))
(show (letrec ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1))))) (od? (lambda (n) (if (= n 0) #f (ev? (- n 1)))))) (list (ev? 10) (od? 7))))
(show (let loop ((i 0) (acc '())) (if (= i 5) acc (loop (+ i 1) (cons i acc)))))
(show (do ((i 0 (+ i 1)) (acc '() (cons (* i i) acc))) ((= i 5) acc)))
(show (map (lambda (x) (cond ((assv x '((1 . one) (2 . two))) => cdr) ((> x 5) 'big) (else 'other))) '(1 2 7 3)))
(show (map (lambda (x) (case x ((a e i o u) 'vowel) ((w y) 'semivowel) (else => (lambda (c) (list 'consonant c))))) '(a w z)))
(show (list (and 1 2 'c) (and) (and #f (car '())) (or #f 3) (or) (or (memq 'b '(a b c)) 'no)))
(when (< 1 2) (show 'when))
(unless (< 1 2) (show 'unless))
(show (let-values (((a b) (values 1 2)) ((c . d) (values 3 4 5))) (list a b c d)))
(show (let*-values (((a) (values 1)) ((b) (values (+ a 1)))) (list a b)))
(define-values (q r) (values 17 4))
(show (list q r))
(define plus (case-lambda (() 0) ((x) x) ((x y) (+ x y)) (args (apply + args))))
(show (list (plus) (plus 1) (plus 1 2) (plus 1 2 3 4)))
(define count 0)
(define p (delay (begin (set! count (+ count 1)) count)))
(let* ((a (force p)) (b (force p)))
  ;; Argument evaluation order is unspecified (R7RS §4.1.3), so count is read after both forces.
  (show (list a b count (promise? p) (force (make-promise 'v)))))
(define (stream-ref s n) (if (= n 0) (car (force s)) (stream-ref (cdr (force s)) (- n 1))))
(define (from n) (delay (cons n (from (+ n 1)))))
(show (stream-ref (from 10) 100))
(show (let ((x 5) (l '(a b))) `(x ,x ,@l (nested `(,x ,,x)) #(1 ,x ,@l) . end)))
(for-each (lambda (a b) (show (+ a b))) '(1 2) '(10 20))
