(import (scheme base) (scheme write))
(define (classify n)
  (cond ((< n 0)
         (display "negative")
         'negative)
        ((= n 0) 'zero)
        (else 'positive)))
(define (never-called x)
  (display x)
  (newline))
(define (count-up n)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        (reverse acc)
        (loop (+ i 1) (cons (classify i) acc)))))
(display (count-up 3))
(newline)
