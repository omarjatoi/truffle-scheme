<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Shared by every Java project in the suite (their "checkstyle" attribute points here). -->
<module name="Checker">
  <property name="severity" value="error"/>
  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile"/>
  <!-- The launcher and the tests are the embedder, not language code: host I/O is fine there. -->
  <module name="SuppressionSingleFilter">
    <property name="files" value="[\\/](src[\\/]launcher|tests)[\\/]"/>
    <property name="checks" value="IllegalImport"/>
  </module>
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="message" value="Trailing whitespace"/>
  </module>
  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="NeedBraces"/>
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="OneStatementPerLine"/>
    <module name="ModifierOrder"/>
    <module name="UpperEll"/>
    <module name="MissingOverride"/>
    <!-- AGENTS.md "Truffle conventions" -->
    <module name="IllegalImport">
      <property name="regexp" value="true"/>
      <property name="illegalClasses" value="^java\.io\.File(InputStream|OutputStream|Reader|Writer)?$, ^java\.nio\.file\..*"/>
      <message key="import.illegal" value="All I/O goes through TruffleLanguage.Env (TruffleFile, Env streams), never java.io/java.nio directly: {0}"/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\.to(Upper|Lower)Case\(\s*\)"/>
      <property name="message" value="Text operations use Locale.ROOT: pass it explicitly"/>
      <property name="ignoreComments" value="true"/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="String\.format\((?!\s*Locale\.ROOT)"/>
      <property name="message" value="Text operations use Locale.ROOT: String.format(Locale.ROOT, ...)"/>
      <property name="ignoreComments" value="true"/>
    </module>
  </module>
</module>
