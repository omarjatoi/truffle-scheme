# Bazel settings for every build, test and run (AGENTS.md "Commands").

# --- Java: GraalVM CE 25.6 for everything (design.md D11, bazel/graalvm.bzl) ---
# Compile Java 25 with the GraalVM javac (bazel/toolchains), run tests and tools on the same
# GraalVM, whose Graal compiler is the JIT the tests exercise.
common --java_language_version=25
common --tool_java_language_version=25
common --java_runtime_version=graalvm_25
common --tool_java_runtime_version=graalvm_25
# No Turbine header jars: the Truffle DSL processor only runs inside javac ("Unsupported compiler
# for element TurbineTypeElement"), and dependents need its generated classes. Dependents compile
# against ijars of the full class jars instead.
build --nojava_header_compilation

# --- C and C++: Bazel's toolchains (design.md D11, "Platforms") ---
# A Linux target compiles with toolchains_buildbuddy's GCC on the executors (--config=remote) or
# with rules_cc's autodetected compiler (--config=local on a Linux host); a macOS target with
# apple_support's Xcode toolchain, on this Mac, with the Xcode bazel/platforms pins. On a Mac,
# rules_cc's autodetection is off: in `nix develop` it would find Nix's clang.
common --xcode_version_config=//bazel/platforms:xcodes
common --macos_minimum_os=11.0
common --enable_platform_specific_config
common:macos --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Python test drivers: no implicit __init__.py files in runfiles (the future default).
common --incompatible_default_to_explicit_init_py

# --- Hermeticity, so results are cacheable across machines ---
# Actions and tests see a fixed PATH, not the shell's: tools come from Bazel (or @chibi). That is
# Bazel 9's default (--incompatible_strict_action_env), as runfiles without the legacy external
# links are.
# Tests start from a clean environment, write only to their sandbox, and use no network.
test --test_output=errors
test --sandbox_default_allow_network=false

# --- Caching ---
# Downloads (GraalVM, Maven jars, Python) land in Bazel's repository cache, which every
# checkout and worktree on a machine shares by default.
# CI (`--config=ci`): the repository cache, which the agents' cache volume keeps
# (.buildkite/pipeline.yml); actions and tests are cached in BuildBuddy (below).
common:ci --repository_cache=~/.cache/bazel-repository-cache
common:ci --color=yes
common:ci --curses=no
common:ci --show_progress_rate_limit=30
# Every command targets the executors' platform on CI (Linux, like the agents), so `bazel run`
# shares `bazel test`'s configuration and analysis.
common:ci --platforms=//bazel/platforms:linux_x86_64
# BuildBuddy (`--config=buildbuddy`): a remote cache shared by CI and local builds, and each
# invocation's results at app.buildbuddy.io. It needs an API key: CI passes the
# BUILDBUDDY_API_KEY secret; locally, put `common:buildbuddy
# --remote_header=x-buildbuddy-api-key=<key>` in ~/.bazelrc or user.bazelrc.
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
common:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
common:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
common:buildbuddy --remote_timeout=10m
common:buildbuddy --remote_cache_compression
# Download only what the command needs at the end (a test's results, a run's runfiles).
common:buildbuddy --remote_download_toplevel

# Remote execution (`--config=remote`, the default) on BuildBuddy's Linux x86_64 executors
# (toolchains_buildbuddy's Ubuntu 22.04 image, MODULE.bazel), with BuildBuddy's cache. Builds still
# target this machine, so `bazel-bin/` and `bazel run` work on a Mac; tests target the executors'
# platform and run there. An action runs on the first execution platform (bazel/platforms) that has
# its toolchains: the executors, or this Mac for a C or C++ action for a macOS target, which needs
# the Xcode toolchain (design.md D11, "Platforms and C and C++ toolchains").
common:remote --config=buildbuddy
common:remote --remote_executor=grpcs://remote.buildbuddy.io
common:remote --extra_execution_platforms=//bazel/platforms:linux_x86_64,//bazel/platforms:macos_arm64
common:remote --extra_toolchains=@toolchains_buildbuddy//toolchains/cc:ubuntu_gcc_x86_64
common:remote --jobs=50
common --config=remote
# A test runs on an execution platform with its target platform's constraints (Bazel 9's default
# test toolchain), so one for this Mac (`--platforms=//bazel/platforms:macos_arm64`) runs here, and
# one for Linux on the executors.
test --platforms=//bazel/platforms:linux_x86_64
# An output directory per platform (design.md D11), named after its CPU as a host of each names its
# own: a test for the executors' Linux (k8-fastbuild, as on CI) leaves this Mac's build
# (darwin_arm64-fastbuild) as it is, and shares CI's cache keys. bazel-bin follows each command's
# platform: after `bazel test` on a Mac, bazel-bin/scheme says to run `bazel build //:scheme`.
common --experimental_platform_in_output_dir=yes
common --experimental_override_platform_cpu_name=//bazel/platforms:linux_x86_64=k8
common --experimental_override_platform_cpu_name=//bazel/platforms:macos_arm64=darwin_arm64
# Offline (`--config=local`): everything runs here, nothing is read from or written to BuildBuddy.
common:local --remote_executor=
common:local --remote_cache=
common:local --bes_backend=
common:local --noremote_upload_local_results
common:local --extra_execution_platforms=
common:local --platforms=@bazel_tools//tools:host_platform

# Per-user settings (a remote cache key, a local disk cache), not checked in.
try-import %workspace%/user.bazelrc
