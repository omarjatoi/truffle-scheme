"""R7RS-small Scheme on GraalVM Truffle: the Bazel build (AGENTS.md "Commands")."""

module(name = "truffle_scheme")

# design.md D11: the GraalVM JDK and the Truffle libraries are the same release. This one
# version picks both: the JDK in bazel/graalvm.bzl and the Maven artifacts below. Upgrading:
# add the release to bazel/graalvm.bzl, change this, `bazel run @jvm//:pin`, and bump
# nixpkgs in flake.lock (the dev shell's GraalVM) together.
TRUFFLE_VERSION = "25.5.5.0.3"

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_python", version = "2.5.1")

# --- JDK: GraalVM CE, pinned and downloaded (bazel/graalvm.bzl) -------------------------------

graalvm = use_extension("//bazel:graalvm.bzl", "graalvm")
graalvm.jdk(version = TRUFFLE_VERSION)
use_repo(graalvm, "graalvm", "graalvm_linux_aarch64", "graalvm_linux_x64", "graalvm_macos_aarch64")

# Runtime toolchains (`--java_runtime_version=graalvm_25`, .bazelrc), then the compilation
# toolchain that runs javac from the same GraalVM (bazel/toolchains/BUILD.bazel).
register_toolchains(
    "@graalvm//:all",
    "//bazel/toolchains:all",
)

# --- Maven: Truffle, the launcher framework and the tools at TRUFFLE_VERSION, and JUnit ---------

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "jvm",
    artifacts = [
        "org.graalvm.sdk:collections:" + TRUFFLE_VERSION,
        "org.graalvm.sdk:word:" + TRUFFLE_VERSION,
        "org.graalvm.sdk:nativeimage:" + TRUFFLE_VERSION,
        "org.graalvm.sdk:jniutils:" + TRUFFLE_VERSION,
        "org.graalvm.sdk:nativebridge:" + TRUFFLE_VERSION,
        "org.graalvm.polyglot:polyglot:" + TRUFFLE_VERSION,
        "org.graalvm.truffle:truffle-api:" + TRUFFLE_VERSION,
        "org.graalvm.truffle:truffle-compiler:" + TRUFFLE_VERSION,
        "org.graalvm.truffle:truffle-runtime:" + TRUFFLE_VERSION,
        "org.graalvm.truffle:truffle-dsl-processor:" + TRUFFLE_VERSION,
        # The launcher framework and the shadowed JLine it requires (scheme.launcher).
        "org.graalvm.sdk:launcher-common:" + TRUFFLE_VERSION,
        "org.graalvm.shadowed:jline:" + TRUFFLE_VERSION,
        # GraalVM's tools: //:scheme and the tools tests put them on the module path.
        "org.graalvm.shadowed:json:" + TRUFFLE_VERSION,
        "org.graalvm.tools:chromeinspector-tool:" + TRUFFLE_VERSION,
        "org.graalvm.tools:dap-tool:" + TRUFFLE_VERSION,
        "org.graalvm.tools:profiler-tool:" + TRUFFLE_VERSION,
        "junit:junit:4.13.2",
        "org.hamcrest:hamcrest-core:1.3",
    ],
    fail_if_repin_required = True,
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "jvm")

# Lint tools (bazel/lint), at the versions GraalVM's projects use, in repositories of their own so
# their dependencies don't mix with the language's: Checkstyle, SpotBugs and ECJ in @lint; the
# Eclipse formatter in @eclipse_formatter, since JDT Core 3.42 needs its own ECJ (3.42).
maven.install(
    name = "lint",
    artifacts = [
        "com.puppycrawl.tools:checkstyle:10.21.0",
        "com.github.spotbugs:spotbugs:4.9.8",
        "org.eclipse.jdt:ecj:3.46.0",
    ],
    fail_if_repin_required = True,
    lock_file = "//bazel/lint:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
maven.install(
    name = "eclipse_formatter",
    # The formatter of Eclipse 4.36 (bazel/lint/EclipseFormat.java).
    artifacts = ["org.eclipse.jdt:org.eclipse.jdt.core:3.42.0"],
    fail_if_repin_required = True,
    lock_file = "//bazel/lint:eclipse_formatter_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "eclipse_formatter", "lint")

# --- Python: the test drivers (bazel/r7rs/*.py), on rules_python's hermetic interpreter ---------

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

# --- Host tools from the Nix dev shell: chibi-scheme (differential tests) ----------------------

host = use_extension("//bazel:host_tools.bzl", "host_tools")
use_repo(host, "chibi")
