load("@rules_python//python:defs.bzl", "py_binary")
load("@graalvm//:version.bzl", GRAALVM_VERSION = "VERSION")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//bazel:java_module.bzl", "java_module_jar", "module_dir", "native_library", "native_setting", "prelude_image", "scheme_runtime")

package(default_visibility = ["//visibility:public"])

exports_files([
    "docs/plan.md",
    "docs/usage.md",
    "maven_install.json",
])

# The Truffle and GraalVM SDK modules the scheme modules require.
_SDK_MODULES = [
    "org.graalvm.collections",
    "org.graalvm.jniutils",
    "org.graalvm.nativebridge",
    "org.graalvm.nativeimage",
    "org.graalvm.polyglot",
    "org.graalvm.truffle",
    "org.graalvm.word",
]

# The standard libraries expanded and compiled at build time (design.md D13), in scheme.jar beside
# the prelude. The language ignores an image whose prelude files differ from the ones it bundles.
prelude_image(
    name = "prelude",
    libs = [
        "//src/builtins",
        "//src/compiler",
        "//src/launcher",
        "//src/prelude",
    ],
)

# scheme.jar: the language as one module. The front end and the primitives are services, so the
# runtime (which holds the language class) needn't depend on them (scheme.runtime.SchemeCompiler).
# It exports nothing to embedders (design.md D11, "Modules"; //tests:module_exports): its packages
# only to the unit tests' modules, but for the records' superclass, which the classes the Static
# Object Model generates in a class loader's unnamed module extend.
java_module_jar(
    name = "scheme_module",
    exports = [
        "scheme.compiler to scheme.test",
        "scheme.reader to scheme.test",
        "scheme.runtime to scheme.test",
        "scheme.runtime.printer to scheme.test",
        "scheme.runtime.staticobject",
        "scheme.runtime.value to scheme.test",
    ],
    libs = [
        "//src/builtins",
        "//src/compiler",
        "//src/prelude",
        "//src/reader",
        "//src/runtime",
    ],
    module_name = "scheme",
    requires = _SDK_MODULES,
    resources = {":prelude": "scheme/prelude/prelude.image"},
    uses = [
        "scheme.runtime.BuiltinLibrary",
        "scheme.runtime.SchemeCompiler",
    ],
    deps = ["//bazel:truffle_modules"],
)

# scheme.launcher.jar: the `scheme` launcher (on GraalVM's launcher framework) and the conformance
# runner, with the optimizing runtime. GraalVM's launcher framework makes SchemeMain by reflection
# in the native launcher (AbstractLanguageLauncher.runLauncher), as GraalJS's launcher exports its
# package to it.
java_module_jar(
    name = "launcher_module",
    exports = ["scheme.launcher to org.graalvm.launcher, scheme.test"],
    libs = ["//src/launcher"],
    module_name = "scheme.launcher",
    requires = _SDK_MODULES + [
        # The JVM's arguments: whether it was given a stack size (EvaluationThread).
        "java.management",
        "org.graalvm.launcher",
        "org.graalvm.shadowed.jline",
        "org.graalvm.truffle.compiler",
        "org.graalvm.truffle.runtime",
        "scheme",
    ],
    deps = [
        ":scheme_module",
        "//bazel:launcher_modules",
        "//bazel:truffle_modules",
    ],
)

# The launcher's module path, as the tests and the commands run it.
scheme_runtime(
    name = "launcher_runtime",
    module = ":launcher_module",
)

# The same with GraalVM's tools (--inspect, --dap, --cpusampler, --memtracer), and the AOT cache
# that `bazel-bin/scheme` starts with (design.md D17, "The AOT cache").
scheme_runtime(
    name = "scheme_runtime",
    aot_training = "//bazel:aot-training.scm",
    extra = ["//bazel:tools_modules"],
    module = ":launcher_module",
)

# `bazel-bin/scheme [option...] [-I dir]... [file.scm [arg...]]` (docs/usage.md).
py_binary(
    name = "scheme",
    srcs = ["//tests/harness:scheme.py"],
    data = [":scheme_runtime"],
    deps = ["//tests/harness"],
)

# `bazel-bin/scheme_jars/`: the language, the launcher and Truffle's jars, for `java -p` (docs/embedding.md).
module_dir(
    name = "scheme_jars",
    module = ":launcher_module",
)

# docs/usage.md and docs/embedding.md, and the files their commands use (tests:readme).
filegroup(
    name = "docs",
    srcs = [
        "docs/embedding.md",
        "docs/usage.md",
    ] + glob(["docs/examples/**"]),
    visibility = ["//tests:__pkg__"],
)

# `bazel-bin/scheme-native`: the launcher as a native executable (design.md D17, docs/usage.md), as
# GraalVM's language standalones ship: GraalVM's thin launcher, which creates the isolate of
# `bazel-bin/libschemevm.{so,dylib}` beside it with its --vm. options and runs SchemeMain there
# (design.md D17, "VM options"). Built only when named: a minute and a few GB, with a
# pre-initialized context (design.md D17, plan.md M8-07). Both are built with the target's C++
# toolchain, on its execution platform: remotely for Linux, on this Mac for macOS (design.md D11,
# "Platforms").
#
# The launcher is launcher.cc from the pinned GraalVM release, unmodified, with the defines
# GraalVM's own build gives it (mx_sdk_vm_impl.py, NativeLibraryLauncherProject). LIBJVM_RELPATH
# (and on macOS LIBJLI_RELPATH) are its JVM mode's, which it falls back to only when the library is
# missing: there is no JVM, so they name the library too.
cc_binary(
    name = "scheme-native",
    srcs = ["@graalvm_launcher_cc//file"],
    copts = [
        "-std=c++17",
        "-O3",
        "-Werror=undef",
    ] + select({
        # launcher.cc uses std::unique_ptr without including <memory>, which LLVM's libc++
        # (GraalVM's toolchain on Linux) includes for it and GCC's libstdc++ doesn't.
        "@platforms//os:linux": [
            "-include",
            "memory",
        ],
        # Its Cocoa event loop's headers are Objective-C.
        "//conditions:default": ["-ObjC++"],
    }),
    data = [":schemevm"],
    linkopts = [
        "-ldl",
        "-pthread",
    ] + select({
        "@platforms//os:linux": ["-static-libstdc++"],
        "//conditions:default": [
            "-framework",
            "Foundation",
        ],
    }),
    local_defines = [
        "CP_SEP=:",
        "DIR_SEP=/",
        "GRAALVM_VERSION=" + GRAALVM_VERSION,
        "LAUNCHER_CLASS=scheme.launcher.SchemeMain",
        "LAUNCHER_MAIN_MODULE=scheme.launcher",
    ] + select({
        "@platforms//os:linux": [
            "LIBLANG_RELPATH=libschemevm.so",
            "LIBJVM_RELPATH=libschemevm.so",
        ],
        "//conditions:default": [
            "LIBLANG_RELPATH=libschemevm.dylib",
            "LIBJVM_RELPATH=libschemevm.dylib",
            "LIBJLI_RELPATH=libschemevm.dylib",
        ],
    }),
    tags = ["manual"],
    deps = ["@graalvm//:jni"],
)

# `bazel-bin/libschemevm.{so,dylib}`: the launcher's module as a shared library. The native-image
# build gets a large executor. On x86-64 Linux the baseline CPU target keeps the JDK's libsimdsort
# (and its static libm) out of it. Its collector is native-image's `--gc=`, from --//:native_gc,
# and --//:native_graalvm=oracle builds it with Oracle GraalVM's native-image, which also has G1
# (design.md D17, "The native image's collector"; docs/usage.md, "Choosing a garbage collector").
native_library(
    name = "schemevm",
    exec_properties = {
        "EstimatedCPU": "8",
        "EstimatedMemory": "12GB",
    },
    gc = ":native_gc",
    graalvm = ":native_graalvm",
    jdk = select({
        ":oracle_graalvm": "@graalvm//:oracle_jdk",
        "//conditions:default": "@bazel_tools//tools/jdk:current_java_runtime",
    }),
    main = "scheme.launcher/scheme.launcher.SchemeMain",
    module = ":launcher_module",
    # A context pre-initialized at build time, which the launcher's context takes over
    # (SchemeLanguage.patchContext): the standard libraries are in the image heap, ready. JLine
    # reaches the terminal through the FFM API, as on the JVM launcher (bazel-bin/scheme): without
    # native access, the executable warns about it on a terminal.
    options = [
        "-Dpolyglot.image-build-time.PreinitializeContexts=scheme",
        "--enable-native-access=org.graalvm.shadowed.jline",
    ] + select({
        "//bazel:linux_x86_64": ["-march=compatibility"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

# `--//:native_gc=serial|epsilon|G1`: //:scheme-native's collector. G1 needs Oracle GraalVM.
native_setting(
    name = "native_gc",
    build_setting_default = "serial",
    values = [
        "serial",
        "epsilon",
        "G1",
    ],
)

# `--//:native_graalvm=ce|oracle`: whose native-image builds //:scheme-native, at the pinned
# version (bazel/graalvm.bzl). Everything else runs on GraalVM CE either way.
native_setting(
    name = "native_graalvm",
    build_setting_default = "ce",
    values = [
        "ce",
        "oracle",
    ],
)

config_setting(
    name = "oracle_graalvm",
    flag_values = {":native_graalvm": "oracle"},
)

# `bazel run //:r7rs -- <command>`: the repository's commands (tests/harness/main.py, AGENTS.md).
alias(
    name = "r7rs",
    actual = "//tests/harness:r7rs",
)
